{
  "name": "@local/nexera",
  "version": "1.2.0-beta",
  "private": true,
  "type": "module",
  "description": "Nexera — a growing DeepSeek Harness workspace plugin. Sticky notes with AI memory, tasks, and a reading list.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "extensions/**"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "sticky-notes"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-sidebar"]
    }
  },
  "dshMobileExtensions": "extensions",
  "dshMobileDataServices": [
    { "service": "nexera", "allow": ["/sticky-notes/"] }
  ]
}
