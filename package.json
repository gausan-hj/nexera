{
  "name": "@local/nexera",
  "version": "1.1.0-beta",
  "private": true,
  "type": "module",
  "description": "Nexera — a growing DeepSeek Harness workspace plugin. First feature: shared sticky notes.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "sticky-notes"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-sidebar"]
    }
  }
}
